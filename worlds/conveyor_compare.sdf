  <!-- ===== Conveyor 3: Fuel conveyor_block mesh + TrackController ===== -->
  <model name="belt_mesh">
    <pose>0 -0.9 0 0 0 0</pose>
    <static>1</static>
    <link name="base_link">
      <visual name="seg_0">
        <pose>-0.26 0 0 0 0 0</pose>
        <geometry><mesh><uri>file:///root/.gz/fuel/fuel.gazebosim.org/open-rmf/models/conveyor_block/4/meshes/conveyor_block_visual.glb</uri></mesh></geometry>
      </visual>
      <visual name="seg_1">
