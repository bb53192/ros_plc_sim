<?xml version="1.0" ?>
<!-- Two-arm color-sorting line (dual-arm-color-sorting branch). Seeded from gripper_cell.sdf.
     M1 adds only the Sensors system plugin + one overhead camera (render smoke test); the second
     station, gates, boxes, unsorted bin and colored parts arrive in M3. -->
<sdf version="1.8">
  <world name="sorting_cell">
    <physics name="1ms" type="ignition.physics.sim" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <gravity>0 0 -9.81</gravity>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- Renders camera sensors. Without this, camera sensors produce no image. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <grid>true</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Conveyor: real friction belt (from gripper_cell.sdf) ================= -->
    <model name="belt_track">
      <pose>1.15 0.35 0 0 0 0</pose>
      <static>1</static>
      <link name="base_link">
        <pose>0 0 0.50 0 0 0</pose>
        <collision name="belt_col">
          <geometry><box><size>1.5 0.30 0.10</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="belt_vis">
          <geometry><box><size>1.5 0.30 0.10</size></box></geometry>
          <material><ambient>0.05 0.05 0.6 1</ambient><diffuse>0.08 0.08 0.75 1</diffuse></material>
        </visual>
        <collision name="roll_a_col">
          <pose>0.75 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><length>0.30</length><radius>0.05</radius></cylinder></geometry>
        </collision>
        <visual name="roll_a_vis">
          <pose>0.75 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><length>0.30</length><radius>0.05</radius></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="roll_b_col">
          <pose>-0.75 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><length>0.30</length><radius>0.05</radius></cylinder></geometry>
        </collision>
        <visual name="roll_b_vis">
          <pose>-0.75 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><length>0.30</length><radius>0.05</radius></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="leg_1"><pose>0.7 0.12 0.225 0 0 0</pose><visual name="v"><geometry><box><size>0.05 0.05 0.45</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link>
      <link name="leg_2"><pose>0.7 -0.12 0.225 0 0 0</pose><visual name="v"><geometry><box><size>0.05 0.05 0.45</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link>
      <link name="leg_3"><pose>-0.7 0.12 0.225 0 0 0</pose><visual name="v"><geometry><box><size>0.05 0.05 0.45</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link>
      <link name="leg_4"><pose>-0.7 -0.12 0.225 0 0 0</pose><visual name="v"><geometry><box><size>0.05 0.05 0.45</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link>
      <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
        <link>base_link</link>
      </plugin>
    </model>

    <!-- End stop + part-present sensor at the belt's delivery (low-X) end (from gripper_cell.sdf).
         Becomes station A in M3. -->
    <model name="conveyor_end_stop">
      <static>true</static>
      <pose>0.40 0.35 0 0 0 0</pose>
      <link name="stop">
        <pose>0 0 0.55 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.02 0.30 0.10</size></box></geometry>
        </collision>
        <sensor name="end_contact" type="contact">
          <contact><collision>collision</collision></contact>
          <update_rate>30</update_rate>
          <always_on>true</always_on>
        </sensor>
        <visual name="visual">
          <geometry><box><size>0.02 0.30 0.10</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.75 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ M1: overhead camera above the station-A pick point ============
         Static model; camera looks straight DOWN (pitch +90deg maps the camera's +X axis to
         world -Z). Publishes gz.msgs.Image on /station_a_cam. Bridged to ROS in M3. -->
    <model name="station_a_camera">
      <static>true</static>
      <pose>0.40 0.35 1.30 0 1.5708 0</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>station_a_cam</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- One workpiece at the belt feed (high-X) end (from gripper_cell.sdf). -->
    <model name="workpiece_1">
      <pose>1.75 0.35 0.58 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>50</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
